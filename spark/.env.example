# Copy this to .env (gitignored) to skip the username/password prompt in the
# notebooks and query_orders.py / compact_orders.py. Falls back to an
# interactive prompt if .env is absent or these are unset.
#
# These are the same dev-only mock-user credentials documented in
# docs/initial_stack.md — not secret, just annoying to retype every run.
SPARK_USERNAME=alice
SPARK_PASSWORD=test1234
