      "clientId": "lakekeeper-ui",
      "name": "Lakekeeper Console",
      "description": "Public client used by Lakekeeper's built-in web console for browser login",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8181/*"
      ],
      "webOrigins": [
        "http://localhost:8181"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "lakekeeper"
      ]
    },
    {
